{
  "manifest_version": 3,
  "name": "JTracker - Send Job to Resume Tracker",
  "version": "1.0.0",
  "description": "Sends the current job page to your local JTracker app, which saves it and generates a tailored resume.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["debugger", "activeTab", "notifications", "sidePanel"],
  "host_permissions": ["http://localhost:8080/*"]
}
